# ===================================================
# Retrievo Backend Environment Template
# (Copy this to .env and fill in your actual credentials)
# ===================================================

# Neon PostgreSQL Database Credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-hostname>/<database-name>?sslmode=require
SPRING_DATASOURCE_USERNAME=<your-db-username>
SPRING_DATASOURCE_PASSWORD=<your-db-password>

# JWT Secret Key (Base64-encoded 256-bit / 384-bit secret)
JWT_SECRET=<your-base64-jwt-secret>

# Google Gemini API Key (From https://aistudio.google.com/)
GEMINI_API_KEY=<your-gemini-api-key>

# Server Port (Default: 8080)
PORT=8080
